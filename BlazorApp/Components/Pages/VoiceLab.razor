@page "/VoiceLab"
@rendermode InteractiveServer
@implements IOperationScopeOwner

@inject IJSRuntime JS
@inject RecorderService Recorder
@inject SpeechToTextService STT
@inject UndoManager UndoManager
@inject IntentService IntentService

@using System.Text.Json
@using BlazorApp.Core.Component
@using BlazorApp.Core.Model
@using BlazorApp.Core.Model.SnapShots
@using BlazorApp.Core.Service
@using Service
@using ViewModel

<CascadingValue Value="(IOperationScopeOwner)this">
    <h3>Voice Lab</h3>

    <h3>🎤 Audio Recorder Test</h3>

    <button @onclick="StartRecording">録音開始</button>
    <button @onclick="StopRecording">録音停止</button>
    <div>
        <p>@status</p>
        <p>@result</p>
    </div>
    <AIInteractionScope DisplayName="個人情報">
        <p>個人情報</p>
        <TrackingScope ViewModel="person" OnChanged="OnPersonChanged">
            <div class="person-form">
                <div class="form-row">
                    <label for="person-name">名前</label>
                    <TextBox DisplayName="名前" Control="NameControl" @bind-Value="person.Name" />
                </div>
                <div class="form-row">
                    <label for="person-adress">住所</label>
                    <TextBox DisplayName="住所" Control="AdressControl" @bind-Value="person.Address" />
                </div>
                @*         <div class="form-row">
                <label for="person-address">住所</label>
                <TextBox @bind-Value="person.Address" />
            </div> *@
                @*          <div class="form-row">
                <label for="person-age">年齢</label>
                <TextBox @bind-Value="person.Age" />
            </div> *@
            </div>
        </TrackingScope>
    </AIInteractionScope>
</CascadingValue>

<div class="interactive-buttons">
    <button class="button small undo" title="巻き戻しctrl+Z"
            @onmousedown="() => UndoManager.Undo()" disabled="@(!UndoManager.CanUndo)">
        <i class="fas fa-undo"></i>
    </button>

    <button class="button small redo" title="やり直しctrl+shift+Z"
            @onmousedown="() => UndoManager.Redo()" disabled="@(!UndoManager.CanRedo)">
        <i class="fas fa-redo"></i>
    </button>
</div>


@code {
    #region Control
    Control NameControl { get; set; } = new();
    Control AdressControl { get; set; } = new();
    #endregion

    #region ViewModel
    private TestPerson person { get; set; } = new();
    # endregion
    private string status = "待機中";
    private string result = "待機中";

    #region LifeCycle
    protected override void OnInitialized()
    {
        base.OnInitialized();
        person.Name = "少女A";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 音声録音の初期化
            await JS.InvokeVoidAsync("voiceRecord.initRecorder",
                DotNetObjectReference.Create(this));

            // Prevの初期値代入
            person.Prev = person.DeepCopy();
        }
    }

    #endregion

    private Task OnPersonChanged(IReversible snapshot)
    {
        var snapshotList = new List<IReversible> { snapshot };
        var snap = new CompositeSnapshot(snapshotList, UndoActionType.Modifyed);
        UndoManager.Push(snap);
        return Task.CompletedTask;
    }


    # region Recording
    private async Task StartRecording()
    {
        status = "録音中…";
        await JS.InvokeVoidAsync("voiceRecord.start");
    }

    private async Task StopRecording()
    {
        status = "録音停止 → 保存中…";
        await JS.InvokeVoidAsync("voiceRecord.stop");


        // AI文字起こし
        var text = await STT.TranscribeAsync(chunks);
        status = "AI文字起こし完了";
        chunks.Clear();
        result = text;

        // ★ ここで Map を作る 
        var operationMap = CreateOperationMap();

        // ★ Intent を作る
        var prompt = IntentParser.BuildPrompt(text, operationMap);
        // AIに私　IntenListを返却してもらう
        var intentList = await IntentService.ParseAsync(text, operationMap);
        // Intent（実行)
        foreach (var intent in intentList)
        {
            ExecuteIntent(intent);
        }   

        StateHasChanged();
    }
    #endregion

    private List<byte[]> chunks = new();

    [JSInvokable]
    public Task OnChunkBase64(string base64Chunk)
    {
        Console.WriteLine($"C# base64 length: {base64Chunk?.Length}");
        var chunk = Convert.FromBase64String(base64Chunk);
        Console.WriteLine($"C# chunk bytes: {chunk.Length}");

        chunks.Add(chunk); // ★ byte[] を追加する
        Console.WriteLine($"Chunk received: {chunk.Length} bytes");
        return Task.CompletedTask;
    }


    private void ExecuteIntent(Intent intent)
    {
        switch (intent.Type)
        {
            case IntentType.Set:
                ApplySet(intent);
                break;

            case IntentType.Submit:
                // ApplySubmit(intent);
                break;

            case IntentType.Undo:
                UndoManager.Undo();
                break;

            case IntentType.Select: // Open??
                // ApplySelect(intent);
                break;

            default:
                break;
        }
    }

    #region Intent Excute
    private void ApplySet(Intent intent)
    {
        var operable = FindOperable(intent.TargetId);

        if (operable is null)
            return;

        operable.SetValue(intent.Value);
    }
    #endregion

    # region AIInteractionScope関連
    public List<AIInteractionScope> Scopes { get; } = [];

    private Dictionary<int, IAIOperable> _operableMap = [];

    public void Register(AIInteractionScope scope)
    {
        Scopes.Add(scope);
    }

    public string CreateOperationMap()
    {
        _operableMap.Clear();

        int id = 1;

        var map =
            Scopes.Select(scope =>
            {
                return new
                {
                    scope.DisplayName,

                    Operables = scope.Operables.Select(x =>
                    {
                        _operableMap[id] = x;

                        return new
                        {
                            Id = id++,
                            Info = x.CreateOperationInfo()
                        };
                    })
                };
            });

        return JsonSerializer.Serialize(
            new
            {
                Scopes = map
            });
    }

    private IAIOperable? FindOperable(int targetId)
    {
        _operableMap.TryGetValue(targetId, out var operable);

        return operable;
    }
    #endregion

}
