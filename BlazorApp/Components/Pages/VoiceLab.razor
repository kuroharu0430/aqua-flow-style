@page "/VoiceLab"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject RecorderService Recorder
@inject SpeechToTextService STT
@using Service
@using ViewModel 
@using BlazorApp.Core.Model

<h3>Voice Lab</h3>

<h3>🎤 Audio Recorder Test</h3>

<button @onclick="StartRecording">録音開始</button>
<button @onclick="StopRecording">録音停止</button>
<div>
    <p>@status</p>
    <p>@result</p>
</div>
<div class="person-form">
    <div class="form-row">
        <label for="person-name">名前</label>
        <input id="person-name"
               type="text"
               class="form-control"
               @bind="person.Name" />
    </div>

    <div class="form-row">
        <label for="person-address">住所</label>
        <input id="person-address"
               type="text"
               class="form-control"
               @bind="person.Address" />
    </div>

    <div class="form-row">
        <label for="person-age">年齢</label>
        <input id="person-age"
               type="number"
               class="form-control"
               @bind="person.Age" />
    </div>
</div>

@code {
    #region Control
    Control NameControl { get; set; } = new();
    #endregion
    private TestPerson person { get; set; } = new();

    private string status = "待機中";
    private string result = "待機中";

    #region lifeCycle
    protected override void OnInitialized()
    {
        base.OnInitialized();
        person.Name = "少女A";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("voiceRecord.initRecorder",
                DotNetObjectReference.Create(this));
        }
    }

    #endregion

    # region Recording
    private async Task StartRecording()
    {
        status = "録音中…";
        await JS.InvokeVoidAsync("voiceRecord.start");
    }

    private async Task StopRecording()
    {
        status = "録音停止 → 保存中…";
        await JS.InvokeVoidAsync("voiceRecord.stop");


        // AI文字起こし
        var text = await STT.TranscribeAsync(chunks);
        status = "AI文字起こし完了";
        chunks.Clear();
        result = text;

        // ★ ここで Meta を作る
        var meta = ViewModelMetaBuilder.Build(person);

        // ★ Intent を作る
        var intent = GetIntent(text, meta);
        // Intent空メソッド呼び出し（実行)
        ExecuteIntent(intent);

        StateHasChanged();
    }
    #endregion

    private List<byte[]> chunks = new();

    [JSInvokable]
    public Task OnChunkBase64(string base64Chunk)
    {
        Console.WriteLine($"C# base64 length: {base64Chunk?.Length}");
        var chunk = Convert.FromBase64String(base64Chunk);
        Console.WriteLine($"C# chunk bytes: {chunk.Length}");

        chunks.Add(chunk); // ★ byte[] を追加する
        Console.WriteLine($"Chunk received: {chunk.Length} bytes");
        return Task.CompletedTask;
    }

    private Intent GetIntent(string text, ViewModelMetadata meta)
    {
        return IntentParser.Parse(text, meta);
    }

    private void ExecuteIntent(Intent intent)
    {
        switch (intent.Type)
        {
            case IntentType.Set:
                ApplySet(intent.Slot);
                break;

            // case IntentType.Toggle:
            //     ApplyToggle(intent.Slot);
            //     break;

            // case IntentType.Move:
            //     ApplyMove(intent.Slot);
            //     break;

            default:
                // 何もしない
                break;
        }
        // ここでIntentを実行する処理を書く
        // 例: VM.ApplyIntent(intent);
    }

    private void ApplySet(Slot slot)
    {
        var vm = GetVMInstance(slot.TargetVM);
        if (vm == null) return;

        var prop = vm.GetType().GetProperty(slot.Field);
        if (prop == null) return;

        var converted = Convert.ChangeType(slot.Value, prop.PropertyType);
        prop.SetValue(vm, converted);
    }

    private object? GetVMInstance(string? targetName)
    {
        // ① 明示的指定
        // 明示的指定
        if (!string.IsNullOrEmpty(targetName))
        {
            return targetName switch
            {
                "TestPerson" => person,
                "NameControl" => NameControl,
                _ => null
            };
        }
        return null;
    }
}
