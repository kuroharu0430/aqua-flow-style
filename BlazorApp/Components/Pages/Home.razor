@page "/"
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Home - aqua-flow-style</PageTitle>

<MainLayout>
    <MainContent>
        <div class="scene">
            <div class="droplet"></div>
            <div class="ripple ripple1"></div>
            <div class="ripple ripple2"></div>

            <p class="typewriter-text">
                <span class="typed"></span><span class="cursor"></span>
            </p>
            <div class="masked-content">
                <div class="water-curtain-wrapper"></div>
                <img class="slide active" src="images/aqua.webp" />
                <img class="slide" src="Images/aquaImage.jpg" />
                <img class="slide" src="Images/aquaImage2.jpeg" />
                <img class="slide" src="Images/dolet.png" />
            </div>
        </div>
        @*         <div class="slider">
            <div class="slides">
                <img src="Images/aquaImage.jpg" />
                <img src="Images/aquaImage2.jpeg" />
                <img src="Images/dolet.png" />
            </div>
        </div> *@
    </MainContent>
</MainLayout>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("Home.Init");
        }
    }
}
