@typeparam T

@using BlazorApp.Core.Model
@using BlazorApp.Core.Model.SnapShots

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    [Parameter] public ITrackable<T> ViewModel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<IReversible>OnChanged { get; set; }

    public async Task NotifyChangedAsync()
    {
        // ★ Track（古い履歴を積む）
        ViewModel.Prev = ViewModel.DeepCopy();      
        await OnChanged.InvokeAsync(ViewModel.CreateSnapShot());      
    }
}